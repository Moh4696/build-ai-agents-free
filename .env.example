# ── Free-tier LLM providers ─────────────────────────────────────────────────
# Groq (no card): https://console.groq.com
GROQ_API_KEY=your_groq_key_here
# Google AI Studio (no card): https://aistudio.google.com
GOOGLE_API_KEY=your_gemini_key_here

# ── Claude API (Designer agent — best script quality) ────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── HeyGen avatar video rendering ────────────────────────────────────────────
HEYGEN_API_KEY=your_heygen_key_here
HEYGEN_AVATAR_ID=your_avatar_id_here
HEYGEN_VOICE_ID=your_voice_id_here

# ── YouTube publishing ────────────────────────────────────────────────────────
# Path to Google OAuth client secrets JSON (download from Google Cloud Console)
YT_CLIENT_SECRETS=credentials/youtube_oauth.json

# ── Instagram publishing (Meta Graph API) ────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your_instagram_long_lived_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# ── TikTok publishing (Content Posting API v2) ───────────────────────────────
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# ── Server config (optional) ─────────────────────────────────────────────────
PORT=8000
ENV=development
